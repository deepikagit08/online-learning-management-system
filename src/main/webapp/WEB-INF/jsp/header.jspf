<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${empty pageTitle ? 'LMS' : pageTitle} | Online Learning Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="${ctx}/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
  <div class="container">
    <a class="navbar-brand" href="${ctx}/dashboard">&#127891; LearnHub LMS</a>
    <c:if test="${not empty sessionScope.user}">
      <div class="d-flex align-items-center gap-3 text-white">
        <a class="text-white text-decoration-none" href="${ctx}/dashboard">Dashboard</a>
        <c:if test="${!sessionScope.user.admin}"><a class="text-white text-decoration-none" href="${ctx}/courses">Courses</a></c:if>
        <c:if test="${sessionScope.user.admin}"><a class="text-white text-decoration-none" href="${ctx}/admin/users">Admin</a></c:if>
        <span class="badge bg-light text-primary"><c:out value="${sessionScope.user.name}"/> &middot; ${sessionScope.user.role}</span>
        <a class="btn btn-sm btn-outline-light" href="${ctx}/logout">Logout</a>
      </div>
    </c:if>
  </div>
</nav>
<div class="container pb-5">
<c:if test="${not empty param.msg}"><div class="alert alert-info"><c:out value="${param.msg}"/></div></c:if>
<c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if>
